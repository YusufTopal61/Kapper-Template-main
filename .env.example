# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore (via *.local) en wordt nooit gecommit.

# ----------------------------------------------------------------- Supabase
# Te vinden in je Supabase dashboard onder Project Settings > API.

# Publiek: wordt in de browser-bundle gezet (VITE_ prefix). Dat is veilig —
# de anon key is beveiligd door Row Level Security.
VITE_SUPABASE_URL="https://jouw-project.supabase.co"
VITE_SUPABASE_ANON_KEY="jouw-anon-key"

# GEHEIM: omzeilt Row Level Security. Nooit een VITE_ prefix geven, want dan
# belandt hij in de browser. Wordt alleen in server functions gebruikt.
SUPABASE_SERVICE_ROLE_KEY="jouw-service-role-key"

# ------------------------------------------------------------------- Resend
# Optioneel. Zonder key blijft de app werken: e-mails worden dan naar de
# server-console gelogd in plaats van verstuurd, zodat een boeking nooit faalt
# op een ontbrekende mailconfiguratie.
RESEND_API_KEY=""
# Afzender. Het domein moet geverifieerd zijn in je Resend-account.
RESEND_FROM="Barber <afspraken@jouwdomein.nl>"

# --------------------------------------------------------------------- Site
# Alleen nodig als de publieke URL niet uit het request af te leiden is
# (bijvoorbeeld achter een proxy). Gebruikt voor annuleerlinks in e-mails.
SITE_URL=""

# ---------------------------------------------------------------- Analytics
# Optioneel, en pas actief nadat een bezoeker akkoord gaat met de cookiebanner.
# Zonder waarde wordt er niets geladen. Maak een gratis Plausible-project aan
# op plausible.io en zet hier het domein dat je daar hebt ingesteld.
VITE_PLAUSIBLE_DOMAIN=""
