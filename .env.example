# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored (see .gitignore) and is never committed.

# ----------------------------------------------------------------- Supabase
# Find these in your Supabase dashboard under Project Settings > API.

# Public: ends up in the browser bundle (NEXT_PUBLIC_ prefix). That is safe —
# the publishable (anon) key is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET: bypasses Row Level Security. Never give it a NEXT_PUBLIC_ prefix, or
# it ends up in the browser. Only used in server-only code.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Resend
# Optional. Without a key the app keeps working: emails are logged to the
# server console instead of being sent, so a booking never fails on missing
# mail configuration.
RESEND_API_KEY=
# Sender. The domain must be verified in your Resend account.
RESEND_FROM="Barber <appointments@example.com>"

# --------------------------------------------------------------------- Site
# The public URL of the site, without a trailing slash. Used for canonical
# URLs, the sitemap, Open Graph, JSON-LD and cancel links in emails.
# REQUIRED in production (the app refuses to start without it); may stay empty locally.
# Example: https://www.example.com
SITE_URL=

# ---------------------------------------------------------------- Analytics
# Optional, and only active after a visitor accepts the cookie banner.
# Without a value nothing is loaded. Create a free Plausible project at
# plausible.io and put the domain you set up there here.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --------------------------------------------------------------------- E2E
# Optional, only for `pnpm test:e2e`. A test admin account for the admin flow
# (create it yourself in Supabase Auth and add it to admin_users). Without
# these, the admin E2E tests are skipped.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
